# ── Supabase (required) ──
NEXT_PUBLIC_SUPABASE_URL=<your-project-url>         # e.g. https://your-project.supabase.co
SUPABASE_URL=<your-project-url>                     # same as above
SUPABASE_STORAGE_URL=<your-project-url>/storage/v1  # storage endpoint
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>       # anon/public key from Supabase dashboard
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>   # service_role key (server-side only!)
SUPABASE_DB_URL=<your-db-connection-string>         # postgresql://postgres:password@host:5432/postgres; supabase CLI + scripts/run-migrations.mjs (reads as DATABASE_URL)

# ── App metadata (optional) ──
APP_VERSION=0.0.0
APP_DOWNLOAD_URL=
APP_UPDATE_CRITICAL=false
APP_RELEASE_NOTES=

# ── AWS (for file uploads / S3) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2

# ── Firebase (for mobile push, optional) ──
FIREBASE_SERVICE_ACCOUNT_JSON='{"your":"service-account-json-string"}'
GOOGLE_APPLICATION_CREDENTIALS=<path-to-service-account-file.json>  # alternative to FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=serviq-mobile
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=

# ── AI / Search (optional) ──
GOOGLE_GEMINI_API_KEY=

# ── Razorpay (Payments) ──
RAZORPAY_KEY_ID=<your-key-id>
RAZORPAY_KEY_SECRET=<your-key-secret>
RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret>
RAZORPAY_ACCOUNT_NUMBER=<your-account-number>          # required for auto-payouts
RAZORPAY_MODE=test                                      # "test" or "live"

# ── Email (Resend) ──
RESEND_API_KEY=re_<your-resend-api-key>
EMAIL_FROM=noreply@serviqapp.com                     # sender address for transactional emails

# ── Internal Auth (required for local session tokens) ──
SERVIQ_INTERNAL_PUSH_KEY=<your-random-secret-key>

# ── Web Push (VAPID, for browser push notifications) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<your-vapid-public-key>    # exposed to browser for push subscription
VAPID_PUBLIC_KEY=<your-vapid-public-key>                # server-side (same value)
VAPID_PRIVATE_KEY=<your-vapid-private-key>
VAPID_EMAIL=<your-vapid-email>

# ── SMS (Twilio, required for order notifications) ──
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_SMS_FROM=<your-twilio-sms-number>             # e.g. +1234567890
TWILIO_WHATSAPP_FROM=<your-twilio-whatsapp-number>   # e.g. +14155238886 (Twilio WhatsApp sandbox or approved number)
TWILIO_MESSAGING_SERVICE_SID=<your-messaging-service-sid>

# ── Redis / KV (required for caching) ──
KV_URL=<your-upstash-kv-url>                         # Upstash KV REST URL (used first)
REDIS_URL=<your-redis-connection-string>              # Standard Redis URL (fallback if KV_URL not set)

# ── Background Jobs / Cron ──
CRON_SECRET=<your-cron-secret>                       # shared secret for cron job authentication
ADMIN_EMAIL_ALLOWLIST=<admin@example.com>             # comma-separated emails with admin access

# ── Google OAuth (for Google Business Profile integration) ──
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_OAUTH_CALLBACK_URL=<your-callback-url>        # e.g. https://serviqapp.com/api/auth/google/callback

# ── Observability (optional, forward client-side events) ──
OBSERVABILITY_FORWARD_URL=<your-forward-url>         # URL to forward observability events to
OBSERVABILITY_FORWARD_TOKEN=<your-forward-token>     # Bearer token for forward URL auth

# ── Auth Link Restrictions (optional, security gate for magic links) ──
AUTH_ALLOWED_DOMAINS=<example.com>                   # comma-separated, restrict sign-in to these email domains
AUTH_MAGIC_LINK_ALLOWED_RECIPIENTS=<user@example.com> # comma-separated, explicit allowlist for magic links
AUTH_MAGIC_LINK_BLOCKED_DOMAINS=<spam.com>           # comma-separated, deny magic links from these domains
AUTH_MAGIC_LINK_BLOCKED_RECIPIENTS=<spammer@example.com> # comma-separated, deny magic links to these emails
