# Runtime secrets for docker-compose on EC2
# Copy to .env.ec2 and fill in real values

NODE_ENV=production

# Supabase (self-hosted)
SUPABASE_URL=http://your-server-ip:8000             # 👈 Replace with your Supabase URL
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://your-server-ip:8000  # 👈 Replace with your Supabase URL
NEXT_PUBLIC_SITE_URL=

# Email
RESEND_API_KEY=
BACKUP_EMAIL_API_KEY=
EMAIL_FROM=noreply@serviqapp.com                     # sender address for transactional emails

# Error tracking
SENTRY_DSN=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER=                               # required for auto-payouts
RAZORPAY_MODE=live                                      # "test" or "live"
SERVIQ_INTERNAL_PUSH_KEY=                                # required for local session JWT tokens

# Web push (VAPID)
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=                         # same as VAPID_PUBLIC_KEY, exposed to browser
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Firebase Cloud Messaging (optional)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=                        # alternative to FIREBASE_SERVICE_ACCOUNT_JSON

# OpenAI (optional)
OPENAI_API_KEY=

# Database (for running migrations directly)
DATABASE_URL=postgresql://postgres:password@your-server-ip:5432/postgres  # 👈 Replace with your DB host

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Redis / KV Cache
KV_URL=
REDIS_URL=

# Background Jobs / Cron
CRON_SECRET=
ADMIN_EMAIL_ALLOWLIST=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://serviqapp.com/api/auth/google/callback

# Observability (forward client-side events)
OBSERVABILITY_FORWARD_URL=
OBSERVABILITY_FORWARD_TOKEN=

# Auth Link Restrictions (optional, security gate for magic links)
AUTH_ALLOWED_DOMAINS=
AUTH_MAGIC_LINK_ALLOWED_RECIPIENTS=
AUTH_MAGIC_LINK_BLOCKED_DOMAINS=
AUTH_MAGIC_LINK_BLOCKED_RECIPIENTS=
