# ServiQ Staging Environment
# Copy to .env.staging and fill in values

# Supabase (staging project)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Site URL
NEXT_PUBLIC_SITE_URL=https://staging.serviq.app

# Payment
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
RAZORPAY_ACCOUNT_NUMBER=your-razorpay-account-number  # required for auto-payouts
RAZORPAY_MODE=test                                     # "test" or "live"

# AI
OPENAI_API_KEY=your-openai-key

# Email
RESEND_API_KEY=your-resend-key
BACKUP_EMAIL_API_KEY=your-backup-email-key
EMAIL_FROM=noreply@serviqapp.com                     # sender address for transactional emails

# Error tracking
SENTRY_DSN=your-sentry-dsn

# Push notifications
SERVIQ_INTERNAL_PUSH_KEY=your-push-key
VAPID_PUBLIC_KEY=your-vapid-public
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public          # same as VAPID_PUBLIC_KEY, exposed to browser
VAPID_PRIVATE_KEY=your-vapid-private
VAPID_EMAIL=your-vapid-email

# Firebase (runtime, not CI secrets)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON='{"your":"service-account-json-string"}'
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-file.json    # alternative to FIREBASE_SERVICE_ACCOUNT_JSON

# Database (for running migrations directly)
DATABASE_URL=postgresql://postgres:password@your-staging-host:5432/postgres

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_SMS_FROM=your-twilio-sms-number
TWILIO_WHATSAPP_FROM=your-twilio-whatsapp-number
TWILIO_MESSAGING_SERVICE_SID=your-messaging-service-sid

# Redis / KV Cache
KV_URL=your-upstash-kv-url
REDIS_URL=your-redis-connection-string

# Background Jobs / Cron
CRON_SECRET=your-cron-secret
ADMIN_EMAIL_ALLOWLIST=admin@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_CALLBACK_URL=https://staging.serviqapp.com/api/auth/google/callback

# Observability (forward client-side events)
OBSERVABILITY_FORWARD_URL=your-forward-url
OBSERVABILITY_FORWARD_TOKEN=your-forward-token

# Auth Link Restrictions (optional, security gate for magic links)
AUTH_ALLOWED_DOMAINS=example.com
AUTH_MAGIC_LINK_ALLOWED_RECIPIENTS=user@example.com
AUTH_MAGIC_LINK_BLOCKED_DOMAINS=spam.com
AUTH_MAGIC_LINK_BLOCKED_RECIPIENTS=spammer@example.com
