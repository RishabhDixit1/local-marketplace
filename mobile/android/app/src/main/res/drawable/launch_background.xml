<?xml version="1.0" encoding="utf-8"?>
<!-- ServiQ branded launch splash screen (Android <12). Brand dark background
     with the centered ServiQ icon. Android 12+ uses the app icon automatically. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_dark" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
