<?xml version="1.0" encoding="utf-8"?>
<!-- ServiQ branded launch splash screen (Android 12+ and 21-25 fall back here;
     Android 12+ may also apply the system splash on top). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_dark" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
